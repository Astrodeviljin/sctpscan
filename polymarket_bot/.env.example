# Polymarket Bot Configuration
# Copy this file to .env and fill in your values

# Your Polymarket private key (export from Polymarket settings)
POLYMARKET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Signature type: 0=EOA/MetaMask, 1=Email/Magic, 2=Gnosis/Browser
POLYMARKET_SIGNATURE_TYPE=1

# Funder address (only needed for Email/Magic wallets - your deposit address)
POLYMARKET_FUNDER_ADDRESS=

# Budget in USDC (1000 EUR ~ 1080 USDC approx)
BETTING_BUDGET_USDC=1080.0

# Max bet per market in USDC
MAX_BET_PER_MARKET=50.0

# Min bet per market in USDC
MIN_BET_PER_MARKET=5.0

# Minimum confidence threshold to place a bet (0.0 to 1.0)
MIN_CONFIDENCE=0.65

# Maximum number of active positions at once
MAX_ACTIVE_POSITIONS=20

# Polling interval in seconds between market scans
POLL_INTERVAL_SECONDS=300

# Dry run mode - set to true to simulate without placing real orders
DRY_RUN=true
